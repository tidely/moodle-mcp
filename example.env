# Copy to `.env` and fill in. `.env` is gitignored; never commit tokens.

# Moodle site root, with trailing slash.
MOODLE_URL=https://moodle.example.edu/

# Optional. A raw wstoken or the full `moodledl://token=...` redirect URL.
# Leave empty to log in via SSO in the browser.
MOODLE_TOKEN=

# Optional. Where downloaded files are cached (default: ~/.moodle-mcp).
# MOODLE_MCP_DIR=

# Optional. Files above this size (MB) are skipped by sync_course (default: 100).
# MOODLE_MCP_MAX_FILE_MB=
